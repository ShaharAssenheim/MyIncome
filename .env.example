# ===========================================
# MyIncome Environment Variables
# ===========================================
# Local:      copy to .env.local and fill in values
# Vercel:     add in Project > Settings > Environment Variables
# Never commit secrets to version control!

# ===========================================
# SUPABASE  (Required — all three)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ===========================================
# VERCEL / PRODUCTION  (optional — for local dev only)
# ===========================================
# On Vercel, NEXT_PUBLIC_SITE_URL is set automatically as the deployment URL.
# For local dev you can leave this unset; window.location.origin is used instead.
# NEXT_PUBLIC_SITE_URL=https://your-app.vercel.app
