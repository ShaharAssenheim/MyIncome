# ===========================================
# MyIncome Environment Variables
# ===========================================
# Local:      copy to .env.local and fill in values
# Vercel:     add in Project > Settings > Environment Variables
# Never commit secrets to version control!

# ===========================================
# SUPABASE  (Required — all three)
# ===========================================
# Get these from: https://supabase.com/dashboard/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here


# ===========================================
# AUTH REDIRECTS
# ===========================================
# Google OAuth uses the current browser origin so production and local sessions
# return to the same host. Configure each callback URL in Supabase Auth instead.
