# Environment Variables Configuration
# Copy this file to .env.local for local development
# For production (Vercel), set these in the Vercel dashboard

# ====================================
# Application URL
# ====================================
# Local development - use localhost
APP_URL=http://localhost:3000

# Production - use your deployed URL (e.g., Vercel)
# APP_URL=https://your-app-name.vercel.app

# ====================================
# JWT Secrets
# ====================================
# Generate strong random strings for production!
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_ACCESS_SECRET=your-access-secret-here
JWT_REFRESH_SECRET=your-refresh-secret-here

# ====================================
# Google OAuth
# ====================================
# Get credentials from: https://console.cloud.google.com/apis/credentials
# Make sure to add authorized redirect URIs:
#   - http://localhost:3000/api/auth/google/callback (for dev)
#   - https://your-app-name.vercel.app/api/auth/google/callback (for production)
GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret

# ====================================
# Supabase
# ====================================
# Get these from: https://app.supabase.com/project/_/settings/api
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
